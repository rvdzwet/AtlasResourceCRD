@code {
    private string _activeTab = "vulns";
    private string _searchTerm = string.Empty;
    private bool _isSidebarOpen = true;
    private bool _isSyncing;
    private string? _syncMessage;

    // Sorting State
    private string _sortColumn = "severity";
    private bool _sortAscending = false;

    // Filter Facets State
    private readonly HashSet<string> _selectedEcosystems = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedSecurityFilter; // null, "vulnerable", "clean"
    private string? _selectedLcmFilter;      // null, "outdated", "uptodate"
    private readonly HashSet<string> _selectedLicenses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedServices = new(StringComparer.OrdinalIgnoreCase);

    // Inspector State
    private CycloneDxVulnerability? _selectedVuln;
    private CycloneDxComponent? _selectedVulnComponent;
    private List<string>? _selectedVulnServices;
    private FleetComponentAggregate? _selectedComponent;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        _selectedEcosystems.Count > 0 ||
        !string.IsNullOrEmpty(_selectedSecurityFilter) ||
        !string.IsNullOrEmpty(_selectedLcmFilter) ||
        _selectedLicenses.Count > 0 ||
        _selectedServices.Count > 0;

    private void SetTab(string tab)
    {
        _activeTab = tab;
        _sortColumn = tab switch
        {
            "vulns" => "severity",
            "sbom" => "name",
            "lcm" => "drift",
            "licenses" => "license",
            _ => "name"
        };
        _sortAscending = tab != "vulns";
    }

    private void ToggleSort(string column)
    {
        if (string.Equals(_sortColumn, column, StringComparison.OrdinalIgnoreCase))
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortIcon(string column)
    {
        if (!string.Equals(_sortColumn, column, StringComparison.OrdinalIgnoreCase)) return " ⇅";
        return _sortAscending ? " ▲" : " ▼";
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        _selectedEcosystems.Clear();
        _selectedSecurityFilter = null;
        _selectedLcmFilter = null;
        _selectedLicenses.Clear();
        _selectedServices.Clear();
    }

    private void ToggleEcosystemFilter(string eco)
    {
        if (_selectedEcosystems.Contains(eco)) _selectedEcosystems.Remove(eco);
        else _selectedEcosystems.Add(eco);
    }

    private void ToggleSecurityFilter(string sec)
    {
        if (_selectedSecurityFilter == sec) _selectedSecurityFilter = null;
        else _selectedSecurityFilter = sec;
    }

    private void ToggleLcmFilter(string lcm)
    {
        if (_selectedLcmFilter == lcm) _selectedLcmFilter = null;
        else _selectedLcmFilter = lcm;
    }

    private void ToggleLicenseFilter(string lic)
    {
        if (_selectedLicenses.Contains(lic)) _selectedLicenses.Remove(lic);
        else _selectedLicenses.Add(lic);
    }

    private void ToggleServiceFilter(string s)
    {
        if (_selectedServices.Contains(s)) _selectedServices.Remove(s);
        else _selectedServices.Add(s);
    }

    private void SelectVulnerability(CycloneDxVulnerability v, CycloneDxComponent? c, IEnumerable<string>? services)
    {
        _selectedComponent = null;
        _selectedVuln = v;
        _selectedVulnComponent = c;
        _selectedVulnServices = services?.ToList();
    }

    private void SelectComponent(FleetComponentAggregate agg)
    {
        _selectedVuln = null;
        _selectedComponent = agg;
    }

    private void CloseInspector()
    {
        _selectedVuln = null;
        _selectedComponent = null;
    }

    private int TotalUniqueComponents => FleetIndex.TotalUniqueComponents;

    private int TotalCriticalHighCves => FleetIndex.TotalCriticalHighCves;

    private int TotalOutdatedComponents => FleetIndex.TotalOutdatedComponents;

    private int TotalDeprecatedComponents => FleetIndex.TotalDeprecatedComponents;

    private int VulnerableComponentsCount => FleetIndex.VulnerableComponentsCount;
    private int CleanComponentsCount => FleetIndex.CleanComponentsCount;

    private Dictionary<string, int> GetAllEcosystemCounts() => FleetIndex.GetEcosystemCounts();

    private Dictionary<string, int> GetAllLicenseCounts() => FleetIndex.GetLicenseCounts();

    private Dictionary<string, int> GetAllServicesWithCounts()
    {
        var summaries = SpecRepo.GetAllSummaries();
        return summaries.ToDictionary(s => s.Name, s => s.SbomComponentCount);
    }

    private List<FleetComponentAggregate> GetAllFleetComponents()
    {
        return FleetIndex.GetPagedComponents(1, 1000).Items;
    }

    private IEnumerable<FleetComponentAggregate> FilteredComponents
    {
        get
        {
            var query = GetAllFleetComponents().AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(c => c.Component.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                         c.Component.Purl.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                         c.Vulnerabilities.Any(v => v.Id.Contains(term, StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrWhiteSpace(v.CveId) && v.CveId.Contains(term, StringComparison.OrdinalIgnoreCase))) ||
                                         c.Services.Any(s => s.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (_selectedEcosystems.Count > 0)
            {
                query = query.Where(c => _selectedEcosystems.Contains(ExtractEcosystem(c.Component.Purl)));
            }

            if (_selectedSecurityFilter == "vulnerable")
            {
                query = query.Where(c => c.Vulnerabilities.Count > 0);
            }
            else if (_selectedSecurityFilter == "clean")
            {
                query = query.Where(c => c.Vulnerabilities.Count == 0);
            }

            if (_selectedLcmFilter == "deprecated")
            {
                query = query.Where(c => c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isDeprecated" && p.Value == "true"));
            }
            else if (_selectedLcmFilter == "outdated")
            {
                query = query.Where(c => c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isOutdated" && p.Value == "true"));
            }
            else if (_selectedLcmFilter == "uptodate")
            {
                query = query.Where(c => !c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isOutdated" && p.Value == "true") && !c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isDeprecated" && p.Value == "true"));
            }

            if (_selectedLicenses.Count > 0)
            {
                query = query.Where(c => {
                    var lic = c.Component.Licenses.FirstOrDefault()?.License?.Name ?? c.Component.Licenses.FirstOrDefault()?.License?.Id ?? "MIT";
                    return _selectedLicenses.Contains(lic);
                });
            }

            if (_selectedServices.Count > 0)
            {
                query = query.Where(c => c.Services.Any(s => _selectedServices.Contains(s)));
            }

            return query;
        }
    }

    private IEnumerable<FleetComponentAggregate> SortedComponents
    {
        get
        {
            var q = FilteredComponents;
            return _sortColumn switch
            {
                "eco" => _sortAscending ? q.OrderBy(c => ExtractEcosystem(c.Component.Purl)) : q.OrderByDescending(c => ExtractEcosystem(c.Component.Purl)),
                "name" => _sortAscending ? q.OrderBy(c => c.Component.Name) : q.OrderByDescending(c => c.Component.Name),
                "version" => _sortAscending ? q.OrderBy(c => c.Component.Version) : q.OrderByDescending(c => c.Component.Version),
                "license" => _sortAscending ? q.OrderBy(c => c.Component.Licenses.FirstOrDefault()?.License?.Name ?? "") : q.OrderByDescending(c => c.Component.Licenses.FirstOrDefault()?.License?.Name ?? ""),
                "security" => _sortAscending ? q.OrderBy(c => c.Vulnerabilities.Count) : q.OrderByDescending(c => c.Vulnerabilities.Count),
                "lcm" => _sortAscending ? q.OrderBy(c => c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isOutdated" && p.Value == "true")) : q.OrderByDescending(c => c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isOutdated" && p.Value == "true")),
                "services" => _sortAscending ? q.OrderBy(c => c.Services.Count) : q.OrderByDescending(c => c.Services.Count),
                _ => q.OrderByDescending(c => c.Vulnerabilities.Count).ThenBy(c => c.Component.Name)
            };
        }
    }

    private IEnumerable<FleetComponentAggregate> SortedLcmComponents
    {
        get
        {
            var q = FilteredComponents;
            return _sortColumn switch
            {
                "eco" => _sortAscending ? q.OrderBy(c => ExtractEcosystem(c.Component.Purl)) : q.OrderByDescending(c => ExtractEcosystem(c.Component.Purl)),
                "name" => _sortAscending ? q.OrderBy(c => c.Component.Name) : q.OrderByDescending(c => c.Component.Name),
                "version" => _sortAscending ? q.OrderBy(c => c.Component.Version) : q.OrderByDescending(c => c.Component.Version),
                "latest" => _sortAscending ? q.OrderBy(c => c.Component.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:latestVersion")?.Value ?? "") : q.OrderByDescending(c => c.Component.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:latestVersion")?.Value ?? ""),
                "published" => _sortAscending ? q.OrderBy(c => c.Component.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:publishedAt")?.Value ?? "") : q.OrderByDescending(c => c.Component.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:publishedAt")?.Value ?? ""),
                "services" => _sortAscending ? q.OrderBy(c => c.Services.Count) : q.OrderByDescending(c => c.Services.Count),
                _ => _sortAscending
                    ? q.OrderBy(c => c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isOutdated" && p.Value == "true")).ThenBy(c => c.Component.Name)
                    : q.OrderByDescending(c => c.Component.Properties.Any(p => p.Name == "atlas:lifecycle:isOutdated" && p.Value == "true")).ThenBy(c => c.Component.Name)
            };
        }
    }

    private IEnumerable<FleetComponentAggregate> SortedLicenseComponents
    {
        get
        {
            var q = FilteredComponents;
            return _sortColumn switch
            {
                "eco" => _sortAscending ? q.OrderBy(c => ExtractEcosystem(c.Component.Purl)) : q.OrderByDescending(c => ExtractEcosystem(c.Component.Purl)),
                "name" => _sortAscending ? q.OrderBy(c => c.Component.Name) : q.OrderByDescending(c => c.Component.Name),
                "version" => _sortAscending ? q.OrderBy(c => c.Component.Version) : q.OrderByDescending(c => c.Component.Version),
                "license" => _sortAscending ? q.OrderBy(c => c.Component.Licenses.FirstOrDefault()?.License?.Name ?? "") : q.OrderByDescending(c => c.Component.Licenses.FirstOrDefault()?.License?.Name ?? ""),
                "services" => _sortAscending ? q.OrderBy(c => c.Services.Count) : q.OrderByDescending(c => c.Services.Count),
                _ => q.OrderBy(c => c.Component.Licenses.FirstOrDefault()?.License?.Name ?? "").ThenBy(c => c.Component.Name)
            };
        }
    }

    private List<VulnerabilityFlatItem> FilteredVulnerabilities
    {
        get
        {
            var list = new List<VulnerabilityFlatItem>();
            foreach (var comp in FilteredComponents)
            {
                foreach (var v in comp.Vulnerabilities)
                {
                    list.Add(new VulnerabilityFlatItem(v, comp.Component, comp.Services.ToList()));
                }
            }
            return list;
        }
    }

    private IEnumerable<VulnerabilityFlatItem> SortedVulnerabilities
    {
        get
        {
            var q = FilteredVulnerabilities;
            return _sortColumn switch
            {
                "severity" => _sortAscending
                    ? q.OrderBy(i => GetSeverityRank(i.Vuln.Ratings.FirstOrDefault()?.Severity)).ThenBy(i => i.Vuln.Id)
                    : q.OrderByDescending(i => GetSeverityRank(i.Vuln.Ratings.FirstOrDefault()?.Severity)).ThenBy(i => i.Vuln.Id),
                "cve" => _sortAscending ? q.OrderBy(i => !string.IsNullOrWhiteSpace(i.Vuln.CveId) ? i.Vuln.CveId : i.Vuln.Id) : q.OrderByDescending(i => !string.IsNullOrWhiteSpace(i.Vuln.CveId) ? i.Vuln.CveId : i.Vuln.Id),
                "component" => _sortAscending ? q.OrderBy(i => i.Component.Name) : q.OrderByDescending(i => i.Component.Name),
                "cvss" => _sortAscending ? q.OrderBy(i => i.Vuln.Ratings.FirstOrDefault()?.Score ?? 5.0) : q.OrderByDescending(i => i.Vuln.Ratings.FirstOrDefault()?.Score ?? 5.0),
                "disclosed" => _sortAscending ? q.OrderBy(i => i.Vuln.Published ?? DateTime.MinValue) : q.OrderByDescending(i => i.Vuln.Published ?? DateTime.MinValue),
                "services" => _sortAscending ? q.OrderBy(i => i.Services.Count) : q.OrderByDescending(i => i.Services.Count),
                "fix" => _sortAscending ? q.OrderBy(i => i.Vuln.FixedVersion ?? "") : q.OrderByDescending(i => i.Vuln.FixedVersion ?? ""),
                _ => q.OrderByDescending(i => GetSeverityRank(i.Vuln.Ratings.FirstOrDefault()?.Severity)).ThenBy(i => i.Vuln.Id)
            };
        }
    }

    private static int GetSeverityRank(string? sev) => sev?.ToLowerInvariant() switch
    {
        "critical" => 4,
        "high" => 3,
        "moderate" or "medium" => 2,
        "low" => 1,
        _ => 2
    };

    private static string GetSeverityBadgeClass(string? sev) => sev?.ToLowerInvariant() switch
    {
        "critical" or "high" => "badge-clean-red",
        "moderate" or "medium" => "badge-clean-gold",
        _ => "badge-clean-green"
    };

    private static string ExtractEcosystem(string purl)
    {
        if (string.IsNullOrWhiteSpace(purl)) return "NuGet";
        if (purl.StartsWith("pkg:npm/", StringComparison.OrdinalIgnoreCase)) return "npm";
        if (purl.StartsWith("pkg:nuget/", StringComparison.OrdinalIgnoreCase)) return "NuGet";
        if (purl.StartsWith("pkg:pypi/", StringComparison.OrdinalIgnoreCase)) return "PyPI";
        if (purl.StartsWith("pkg:maven/", StringComparison.OrdinalIgnoreCase)) return "Maven";
        if (purl.StartsWith("pkg:golang/", StringComparison.OrdinalIgnoreCase) || purl.StartsWith("pkg:go/", StringComparison.OrdinalIgnoreCase)) return "Go";
        return "NuGet";
    }

    private static string FormatRelativeAge(DateTime? date)
    {
        if (!date.HasValue) return "Unknown";
        var span = DateTime.UtcNow - date.Value;
        if (span.TotalDays < 1) return "Today";
        if (span.TotalDays < 2) return "Yesterday";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} days ago";
        if (span.TotalDays < 30) return $"{(int)(span.TotalDays / 7)} weeks ago";
        if (span.TotalDays < 365) return $"{(int)(span.TotalDays / 30)} months ago";
        var years = (int)(span.TotalDays / 365);
        return years == 1 ? "1 year ago" : $"{years} years ago";
    }

    private record VersionDriftInfo(string Label, string BadgeClass);

    private static VersionDriftInfo ClassifyVersionDrift(string currentVer, string latestVer, bool isDeprecated)
    {
        if (isDeprecated) return new VersionDriftInfo("🚨 Deprecated", "badge-clean-red");
        if (string.Equals(currentVer, latestVer, StringComparison.OrdinalIgnoreCase))
            return new VersionDriftInfo("✓ Up to date", "badge-clean-green");

        var curMajor = currentVer.Split('.')[0].TrimStart('v', '^', '~');
        var latMajor = latestVer.Split('.')[0].TrimStart('v', '^', '~');

        if (int.TryParse(curMajor, out var cMaj) && int.TryParse(latMajor, out var lMaj) && lMaj > cMaj)
        {
            return new VersionDriftInfo($"Major (+{lMaj - cMaj})", "badge-clean-gold");
        }

        return new VersionDriftInfo("Update Avail", "badge-clean-purple");
    }

    private async Task RescanFleetCvesAsync()
    {
        _isSyncing = true;
        _syncMessage = null;
        StateHasChanged();

        try
        {
            var report = await SyncService.SyncAllServicesAsync();
            _syncMessage = $"✅ {report.Message}";
        }
        catch (Exception ex)
        {
            _syncMessage = $"❌ Failed to rescan CVEs: {ex.Message}";
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private async Task ExportFleetSbomAsync()
    {
        var allComponents = GetAllFleetComponents();
        var fleetSbom = new CycloneDxSbom
        {
            BomFormat = "CycloneDX",
            SpecVersion = "1.5",
            Metadata = new CycloneDxMetadata
            {
                Timestamp = DateTime.UtcNow,
                Component = new CycloneDxComponent
                {
                    Type = "application",
                    Name = "EnterpriseFleet",
                    Version = "1.0.0",
                    Description = "Global Consolidated Enterprise SBOM"
                }
            },
            Components = allComponents.Select(c => c.Component).ToList(),
            Vulnerabilities = allComponents.SelectMany(c => c.Vulnerabilities).DistinctBy(v => v.Id).ToList()
        };

        var json = System.Text.Json.JsonSerializer.Serialize(fleetSbom, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("downloadFileFromText", "fleet-cyclonedx-bom.json", json);
    }

    private static readonly Markdig.MarkdownPipeline _markdownPipeline = new Markdig.MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private static string RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return string.Empty;
        try
        {
            return Markdig.Markdown.ToHtml(markdown, _markdownPipeline);
        }
        catch
        {
            return System.Web.HttpUtility.HtmlEncode(markdown);
        }
    }
