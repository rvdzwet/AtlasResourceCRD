@page "/blast-radius"
@rendermode InteractiveServer
@inject SpecDocumentRepository SpecRepo
@inject Neo4jGraphService Neo4j
@inject NavigationManager Nav

<PageTitle>Blast Radius & Risk Register - Atlas Enterprise Hub</PageTitle>

<!-- Header in Clean SaaS Card -->
<div class="saas-card" style="margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="saas-card-title" style="font-size: 1.65rem;">
                🚨 Cross-Service Blast Radius & Enterprise Risk Register
            </h1>
            <p style="color: var(--text-secondary); margin-top: 0.25rem; font-size: 0.92rem;">
                Evaluate failure containment, dependency cascades, and fleet-wide ISO 27001 / STRIDE architectural risk registers across @SpecRepo.TotalServicesCount.ToString("N0") services.
            </p>
        </div>

        <!-- Quick Fleet Risk Metrics -->
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <span class="badge-clean-red">🔴 @_totalCriticalRisks Critical Risks</span>
            <span class="badge-clean-gold">🟡 @_totalHighRisks High Risks</span>
            <span class="badge-clean-green">🟢 @_totalApprovedServices / @SpecRepo.TotalServicesCount.ToString("N0") Approved</span>
        </div>
    </div>
</div>

<!-- SECTION 1: Interactive Outage & Cascade Simulator -->
<div class="saas-card" style="margin-bottom: 1.5rem;">
    <div class="saas-card-header">
        <div>
            <h2 class="saas-card-title">⚡ Interactive Microservice Outage Simulator</h2>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">Simulate the cascading impact of a primary service outage</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_selectedService))
        {
            <button class="saas-filter-pill" @onclick="ResetSimulator">Reset Simulator</button>
        }
    </div>

    <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap;">
        <label style="font-weight: 700; color: var(--text-main); font-size: 0.92rem;">Simulate Primary Outage In:</label>
        <ServiceSearchSelect SelectedService="@_selectedService"
                             SelectedServiceChanged="OnServiceSelected"
                             Placeholder="Type service name to simulate outage..."
                             MaxWidth="420px" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_selectedService) && _targetResource != null)
    {
        var risk = _targetResource.Spec?.RiskSummary;

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
            <!-- Simulated Primary Failure Card -->
            <div style="background: var(--accent-coral-light); border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 12px; padding: 1.25rem;">
                <div style="font-size: 0.8rem; color: var(--accent-coral); text-transform: uppercase; font-weight: 700;">Simulated Point of Failure</div>
                <div style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">@_selectedService</div>
                <div style="margin-top: 0.5rem; font-size: 0.88rem; color: var(--text-secondary);">
                    <strong>Tier:</strong> @(_targetResource.Spec?.ComponentOverview?.Tier ?? "Backend") | 
                    <strong>Risk:</strong> <span class="badge-clean-red">@(risk?.OverallRiskLevel ?? "High")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(risk?.BlastRadiusEvaluation))
                {
                    <p style="margin-top: 0.75rem; font-size: 0.85rem; color: var(--text-main); border-top: 1px solid rgba(248, 113, 113, 0.3); padding-top: 0.5rem;">
                        @risk.BlastRadiusEvaluation
                    </p>
                }
            </div>

            <!-- Downstream Impact Card -->
            <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1.25rem;">
                <div style="font-size: 0.8rem; color: var(--primary-purple); text-transform: uppercase; font-weight: 700;">
                    Cascading Impact Scope
                </div>
                <div style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">
                    @(_downstreamServices.Count > 0 ? $"{_downstreamServices.Count} Downstream Services Impacted" : "Zero Downstream Cascades")
                </div>
                <div style="margin-top: 0.5rem;">
                    @if (_downstreamServices.Count > 0)
                    {
                        <span class="badge-clean-red">⚠️ High Fleet Availability Risk</span>
                    }
                    else
                    {
                        <span class="badge-clean-green">🛡️ Contained Failure / Leaf Component</span>
                    }
                </div>
            </div>
        </div>

        @if (_downstreamServices.Count > 0)
        {
            <div style="margin-top: 1rem;">
                <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.75rem;">Affected Downstream Applications:</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem;">
                    @foreach (var down in _downstreamServices)
                    {
                        <div style="background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 10px; padding: 0.85rem 1rem;">
                            <a href="/catalog/@down.Name" style="font-weight: 700; color: var(--primary-purple); text-decoration: none;">
                                📦 @down.Name
                            </a>
                            <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">
                                Tier: @down.Tier | Domain: @down.Domain
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_coLocatedServices.Count > 0)
        {
            <div style="margin-top: 1.25rem; padding: 1rem 1.25rem; background: #FAF5FF; border: 1px solid #E9D5FF; border-radius: 10px;">
                <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem;">
                    🖥️ Shared Infrastructure Blast Radius (@_coLocatedServices.Count Co-Located Services)
                </h4>
                <p style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
                    If the physical/virtual node or namespace hosting <strong>@_selectedService</strong> suffers hardware exhaustion or a hypervisor fault, these workloads share the same blast radius:
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    @foreach (var co in _coLocatedServices)
                    {
                        <a href="/catalog/@co.ServiceName" class="saas-filter-pill" style="text-decoration: none; background: #FFF; border-color: #DDD6FE;">
                            <span>📦 @co.ServiceName</span>
                            <span class="badge-clean-purple" style="font-size: 0.7rem;">@co.SharedResource</span>
                        </a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div style="background: var(--bg-subtle); border: 1px dashed var(--border-card); border-radius: 12px; padding: 2.5rem; text-align: center; color: var(--text-muted);">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🌐</div>
            Select any microservice above to simulate its outage cascade across the enterprise.
        </div>
    }
</div>

<!-- SECTION 2: Enterprise Risk Register Table -->
<div class="saas-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 1.25rem 1.5rem 0.75rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h2 class="saas-card-title" style="font-size: 1.2rem;">📋 Enterprise Architectural Risk Register</h2>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">@_allRisks.Count Registered Architecture Risks</div>
        </div>

        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <input type="text" class="saas-input" style="width: 200px;" placeholder="🔍 Filter risks..." @bind="_riskFilterTerm" @bind:event="oninput" @bind:after="FilterRisks" />
            <button class="saas-filter-pill @(_selectedRiskSeverity == "All" ? "active" : "")" @onclick='() => SetRiskSeverity("All")'>All</button>
            <button class="saas-filter-pill @(_selectedRiskSeverity == "Critical" ? "active" : "")" @onclick='() => SetRiskSeverity("Critical")'>Critical</button>
            <button class="saas-filter-pill @(_selectedRiskSeverity == "High" ? "active" : "")" @onclick='() => SetRiskSeverity("High")'>High</button>
            <button class="saas-filter-pill @(_selectedRiskSeverity == "Medium" ? "active" : "")" @onclick='() => SetRiskSeverity("Medium")'>Medium</button>
        </div>
    </div>

    <div style="overflow-x: auto;">
        <table class="saas-table" style="width: 100%;">
            <thead>
                <tr>
                    <th>Microservice</th>
                    <th>Risk Title</th>
                    <th>Level</th>
                    <th>Likelihood</th>
                    <th>Impact / Consequence</th>
                    <th>Trigger Scenario</th>
                    <th>Required Mitigation</th>
                </tr>
            </thead>
            <tbody>
                @if (_pagedRisks.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                            No architectural risks matched the filter criteria.
                        </td>
                    </tr>
                }
                @foreach (var item in _pagedRisks)
                {
                    <tr>
                        <td>
                            <a href="/catalog/@item.ServiceName" style="color: var(--primary-purple); font-weight: 700; text-decoration: none;">
                                @item.ServiceName
                            </a>
                        </td>
                        <td><strong>@item.Risk.RiskTitle</strong></td>
                        <td>
                            <span class="@(item.Risk.RiskLevel == "Critical" || item.Risk.RiskLevel == "High" ? "badge-clean-red" : (item.Risk.RiskLevel == "Medium" ? "badge-clean-gold" : "badge-clean-green"))">
                                @item.Risk.RiskLevel
                            </span>
                        </td>
                        <td style="color: var(--text-secondary);">@item.Risk.Likelihood</td>
                        <td style="color: var(--text-main); font-size: 0.85rem; max-width: 280px;">@item.Risk.Impact</td>
                        <td style="color: var(--text-secondary); font-size: 0.82rem; max-width: 250px;">@item.Risk.TriggerScenario</td>
                        <td style="color: #15803D; font-size: 0.85rem; max-width: 280px;">@item.Risk.RequiredMitigation</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <PaginationControls
        CurrentPage="@_riskPage"
        TotalPages="@_riskTotalPages"
        TotalItems="@_filteredRisksList.Count"
        PageSize="@_riskPageSize"
        CurrentPageChanged="SetRiskPage"
        PageSizeChanged="OnRiskPageSizeChanged" />
</div>

@code {
    private string _selectedService = string.Empty;
    private AtlasResource? _targetResource;
    private List<ServiceSummaryRecord> _downstreamServices = new();
    private List<CoLocatedServiceSummary> _coLocatedServices = new();

    private string _riskFilterTerm = string.Empty;
    private string _selectedRiskSeverity = "All";
    private int _riskPage = 1;
    private int _riskPageSize = 25;

    private int _totalCriticalRisks;
    private int _totalHighRisks;
    private int _totalApprovedServices;

    private record FleetRiskItem(string ServiceName, RiskItem Risk);
    private List<FleetRiskItem> _allRisks = new();
    private List<FleetRiskItem> _filteredRisksList = new();
    private List<FleetRiskItem> _pagedRisks = new();
    private int _riskTotalPages = 1;

    protected override void OnInitialized()
    {
        CalculateFleetRiskMetrics();
        FilterRisks();
    }

    private void CalculateFleetRiskMetrics()
    {
        var summaries = SpecRepo.GetAllSummaries();
        _totalApprovedServices = summaries.Count(s => s.ProductionReadiness == "Approved" || s.ProductionReadiness == "Ready");

        _allRisks = SpecRepo.GetAll()
            .SelectMany(r => (r.Spec?.RiskSummary?.Risks ?? new List<RiskItem>())
                .Select(rk => new FleetRiskItem(r.Metadata.Name, rk)))
            .ToList();

        _totalCriticalRisks = _allRisks.Count(r => string.Equals(r.Risk.RiskLevel, "Critical", StringComparison.OrdinalIgnoreCase));
        _totalHighRisks = _allRisks.Count(r => string.Equals(r.Risk.RiskLevel, "High", StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnServiceSelected(string serviceName)
    {
        _selectedService = serviceName;
        if (string.IsNullOrWhiteSpace(serviceName))
        {
            _targetResource = null;
            _downstreamServices.Clear();
            return;
        }

        _targetResource = SpecRepo.GetByName(serviceName);
        _downstreamServices.Clear();

        // 1. Try Neo4j graph traversal for downstream services
        if (Neo4j.IsConnected)
        {
            try
            {
                var cypher = "MATCH (s:Service { name: $name })<-[:CALLS|DEPENDS_ON*1..2]-(d:Service) RETURN DISTINCT d.name AS name";
                var records = await Neo4j.QueryAsync(cypher, new { name = serviceName });
                var names = records.Select(r => r["name"]?.ToString()).Where(n => !string.IsNullOrEmpty(n)).ToHashSet();
                _downstreamServices = SpecRepo.GetAllSummaries().Where(s => names.Contains(s.Name)).ToList();
            }
            catch { }
        }

        // 2. Fallback to in-memory summary / spec check if Neo4j returned zero
        if (_downstreamServices.Count == 0)
        {
            _downstreamServices = SpecRepo.GetAll()
                .Where(r => r.Metadata.Name != serviceName &&
                            r.Spec.Dependencies?.InternalServices != null &&
                            r.Spec.Dependencies.InternalServices.Any(d => string.Equals(d.Name, serviceName, StringComparison.OrdinalIgnoreCase)))
                .Select(r => SpecRepo.GetSummary(r.Metadata.Name) ?? ServiceSummaryRecord.FromResource(r))
                .ToList();
        }

        // 3. Load co-located services sharing same host / cluster
        if (Neo4j.IsConnected)
        {
            try
            {
                _coLocatedServices = await Neo4j.GetCoLocatedServicesAsync(serviceName);
            }
            catch { }
        }
    }

    private void ResetSimulator()
    {
        _selectedService = string.Empty;
        _targetResource = null;
        _downstreamServices.Clear();
        _coLocatedServices.Clear();
    }

    private void SetRiskSeverity(string sev)
    {
        _selectedRiskSeverity = sev;
        _riskPage = 1;
        FilterRisks();
    }

    private void FilterRisks()
    {
        var query = _allRisks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_riskFilterTerm))
        {
            var term = _riskFilterTerm.Trim();
            query = query.Where(i => i.ServiceName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                     i.Risk.RiskTitle.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                     i.Risk.Impact.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                     i.Risk.RequiredMitigation.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (_selectedRiskSeverity != "All")
        {
            query = query.Where(i => string.Equals(i.Risk.RiskLevel, _selectedRiskSeverity, StringComparison.OrdinalIgnoreCase));
        }

        _filteredRisksList = query.ToList();
        _riskTotalPages = Math.Max(1, (int)Math.Ceiling((double)_filteredRisksList.Count / _riskPageSize));
        _riskPage = Math.Max(1, Math.Min(_riskTotalPages, _riskPage));
        _pagedRisks = _filteredRisksList.Skip((_riskPage - 1) * _riskPageSize).Take(_riskPageSize).ToList();
    }

    private void SetRiskPage(int page)
    {
        _riskPage = page;
        FilterRisks();
    }

    private void OnRiskPageSizeChanged(int size)
    {
        _riskPageSize = size;
        _riskPage = 1;
        FilterRisks();
    }
}
