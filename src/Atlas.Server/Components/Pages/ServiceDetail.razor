                    <span class="badge-clean-gold">@spec.CodeReview.CodeSmells.Count Smells</span>
                </div>

                <table class="saas-table" style="margin-bottom: 1.5rem;">
                    <thead>
                        <tr>
                            <th>Smell Type</th>
                            <th>Affected Component / File</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var smell in spec.CodeReview.CodeSmells)
                        {
                            <tr>
                                <td><span class="badge-clean-gold">@smell.SmellType</span></td>
                                <td><code>@smell.AffectedComponentOrFile</code></td>
                                <td style="color: var(--text-secondary);">@smell.Description</td>
