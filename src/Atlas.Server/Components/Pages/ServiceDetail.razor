        @if (spec.ApiContracts?.Events != null && spec.ApiContracts.Events.Count > 0)
        {
            <div class="saas-card">
                <div class="saas-card-header">
                    <h3 class="saas-card-title">Asynchronous Event Contracts & Message Streams</h3>
                    <span class="badge-clean-gold">@spec.ApiContracts.Events.Count Streams</span>
                </div>

                <table class="saas-table">
                    <thead>
                        <tr>
                            <th>Topic / Queue</th>
                            <th>Action</th>
                            <th>Payload Type</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in spec.ApiContracts.Events)
                        {
                            <tr>
                                <td><code style="font-weight: 700; color: #B45309;">@ev.TopicOrQueue</code></td>
                                <td><span class="badge-clean-gold">@ev.Action</span></td>
                                <td><code>@(ev.PayloadType ?? "JSON Schema")</code></td>
                                <td style="color: var(--text-secondary);">@ev.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
