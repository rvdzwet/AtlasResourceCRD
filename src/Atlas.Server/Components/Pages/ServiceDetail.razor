                    <span class="badge-clean-purple">@spec.CodeReview.Findings.Count Recommendations</span>
                </div>

                @foreach (var f in spec.CodeReview.Findings)
                {
                    <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 0.75rem;">
