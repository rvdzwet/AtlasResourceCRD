    <!-- TAB 4: Data Stores & Configuration -->
    @if (_activeTab == "datastores")
    {
        <div class="saas-card" style="margin-bottom: 1.5rem;">
            <div class="saas-card-header">
                <h3 class="saas-card-title">Persistence & Data Stores</h3>
                <span class="badge-clean-green">@(spec.DataStores?.Databases?.Count ?? 0) Databases</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                @foreach (var db in spec.DataStores?.Databases ?? new List<DataStoreSpec>())
                {
                    <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1.25rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <strong style="color: var(--text-main);">🗄️ @db.Name</strong>
                            <span class="badge-clean-green">@db.Type</span>
                        </div>
                        <div style="font-size: 0.85rem; color: var(--text-secondary);">Role: @db.Role</div>
                        <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.35rem;">@db.Description</div>
                    </div>
                }
            </div>

            <!-- Environment Variables -->
            <div class="saas-card-header">
                <h4 class="saas-card-title">Environment Variables & Configuration</h4>
                <span class="badge-clean-purple">@(spec.Configuration?.EnvironmentVariables?.Count ?? 0) Variables</span>
            </div>

            @if (spec.Configuration?.EnvironmentVariables != null && spec.Configuration.EnvironmentVariables.Count > 0)
            {
                <table class="saas-table" style="margin-bottom: 1.5rem;">
                    <thead>
                        <tr>
                            <th>Variable Name</th>
                            <th>Required</th>
                            <th>Secret</th>
                            <th>Default Value</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var env in spec.Configuration.EnvironmentVariables)
                        {
                            <tr>
                                <td><code style="font-weight: 700; color: var(--primary-purple);">@env.Name</code></td>
                                <td>@(env.Required ? "🔴 Yes" : "⚪ Optional")</td>
                                <td>@(env.IsSecret ? "🔒 Secret" : "📄 Plain")</td>
                                <td><code>@(env.DefaultValue ?? "N/A")</code></td>
                                <td style="color: var(--text-secondary);">@env.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Standard environment configuration.</p>
            }

            @if (spec.Configuration?.ConfigFiles != null && spec.Configuration.ConfigFiles.Count > 0)
            {
                <div class="saas-card-header">
                    <h4 class="saas-card-title">Configuration Files & Schemas</h4>
                    <span class="badge-clean-purple">@spec.Configuration.ConfigFiles.Count Files</span>
                </div>

                <table class="saas-table">
                    <thead>
                        <tr>
                            <th>File Path</th>
                            <th>Format</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cf in spec.Configuration.ConfigFiles)
                        {
                            <tr>
                                <td><code style="font-weight: 700; color: var(--primary-purple);">@cf.Path</code></td>
                                <td><span class="badge-clean-purple">@cf.Format</span></td>
                                <td style="color: var(--text-secondary);">@cf.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <!-- TAB 5: Observability & Health -->
    @if (_activeTab == "observability")
    {
        <div class="saas-card">
            <div class="saas-card-header">
                <h3 class="saas-card-title">Observability, Health & Telemetry</h3>
                <span class="badge-clean-purple">Logging: @(spec.Observability?.Logging?.Framework ?? "Serilog / JSON")</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1.25rem;">
                    <div style="font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem;">📜 Structured Logging</div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Framework: <strong>@(spec.Observability?.Logging?.Framework ?? "Serilog")</strong></div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Format: @(spec.Observability?.Logging?.Format ?? "Structured JSON")</div>
                    <div style="margin-top: 0.5rem; display: flex; gap: 0.35rem; flex-wrap: wrap;">
                        @foreach (var sink in spec.Observability?.Logging?.Sinks ?? new List<string>())
                        {
                            <span class="badge-clean-purple">Sink: @sink</span>
                        }
                    </div>
                </div>

                <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1.25rem;">
                    <div style="font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem;">📊 Metrics & Tracing</div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Exporter: <strong>@(spec.Observability?.Metrics?.Exporter ?? "OpenTelemetry / Prometheus")</strong></div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Tracing: <strong>@(spec.Observability?.Tracing?.Protocol ?? "OpenTelemetry")</strong></div>
                    @if (spec.Observability?.Metrics?.KeyMetrics != null && spec.Observability.Metrics.KeyMetrics.Count > 0)
                    {
                        <div style="margin-top: 0.5rem; display: flex; gap: 0.25rem; flex-wrap: wrap;">
                            @foreach (var m in spec.Observability.Metrics.KeyMetrics.Take(3))
                            {
                                <code style="font-size: 0.75rem; background: #F0EDFF; color: var(--primary-purple); padding: 0.1rem 0.35rem; border-radius: 4px;">@m</code>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Health Check Probes -->
            <div class="saas-card-header">
                <h4 class="saas-card-title">Kubernetes / Cloud Health Probes</h4>
                <span class="badge-clean-green">@(spec.Observability?.HealthChecks?.Count ?? 0) Probes</span>
            </div>

            <table class="saas-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Endpoint / Probe</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var probe in spec.Observability?.HealthChecks ?? new List<HealthCheckSpec>())
                    {
                        <tr>
                            <td><span class="badge-clean-green">@probe.Type</span></td>
                            <td><code>@probe.EndpointOrCommand</code></td>
                            <td style="color: var(--text-secondary);">@probe.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- TAB 6: Security & OWASP Top 10 -->
    @if (_activeTab == "security")
    {
        <div class="saas-card" style="margin-bottom: 1.5rem;">
            <div class="saas-card-header">
                <div>
                    <h3 class="saas-card-title">Security Posture & OWASP Top 10 Audit</h3>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Overall Rating: <strong>@(spec.Security?.OverallRating ?? "A")</strong> (Score: @(spec.Security?.SecurityScore ?? 90)/100)</div>
                </div>
                <span class="badge-clean-green">Security Grade @(spec.Security?.OverallRating ?? "A")</span>
            </div>

            <!-- OWASP Compliance Checklist -->
            @if (spec.Security?.OwaspCompliance != null && spec.Security.OwaspCompliance.Count > 0)
            {
                <table class="saas-table" style="margin-bottom: 1.5rem;">
                    <thead>
                        <tr>
                            <th>OWASP Category</th>
                            <th>Status</th>
                            <th>Evidence & Architectural Defense</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var owasp in spec.Security.OwaspCompliance)
                        {
                            <tr>
                                <td><strong>@owasp.Category</strong></td>
                                <td>
                                    <span class="@(owasp.Status == "Compliant" ? "badge-clean-green" : "badge-clean-gold")">
                                        @owasp.Status
                                    </span>
                                </td>
                                <td style="color: var(--text-secondary); font-size: 0.88rem;">@owasp.Evidence</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <!-- Security Findings -->
            @if (spec.Security?.Findings != null && spec.Security.Findings.Count > 0)
            {
                <div class="saas-card-header">
                    <h4 class="saas-card-title">Active Security Findings</h4>
                    <span class="badge-clean-red">@spec.Security.Findings.Count Findings</span>
                </div>

                @foreach (var f in spec.Security.Findings)
                {
                    <div style="background: #FFF5F5; border-left: 4px solid var(--accent-coral); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 0.85rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                            <strong style="color: #991B1B;">@f.Title</strong>
                            <span class="badge-clean-red">@f.Severity</span>
                        </div>
                        <p style="font-size: 0.88rem; color: var(--text-main); margin-bottom: 0.5rem;">@f.Description</p>
                        <div style="font-size: 0.82rem; color: #166534; background: #DCFCE7; padding: 0.4rem 0.75rem; border-radius: 6px;">
                            <strong>Mitigation:</strong> @f.Mitigation
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- TAB 7: STRIDE Threat Model -->
    @if (_activeTab == "threatmodel")
    {
        <div class="saas-card">
            <div class="saas-card-header">
                <div>
                    <h3 class="saas-card-title">STRIDE Threat Modeling & Attack Surface Matrix</h3>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Methodology: @(spec.ThreatModel?.Methodology ?? "Microsoft STRIDE")</div>
                </div>
                <span class="badge-clean-red">@(spec.ThreatModel?.Threats?.Count ?? 0) Active Threat Vectors</span>
            </div>

            <!-- Trust Boundaries -->
            @if (spec.ThreatModel?.TrustBoundaries != null && spec.ThreatModel.TrustBoundaries.Count > 0)
            {
                <div class="saas-card-header" style="margin-top: 0.5rem;">
                    <h4 class="saas-card-title">Architectural Trust Boundaries</h4>
                    <span class="badge-clean-purple">@spec.ThreatModel.TrustBoundaries.Count Boundaries</span>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                    @foreach (var tb in spec.ThreatModel.TrustBoundaries)
                    {
                        <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1.1rem;">
                            <div style="font-weight: 700; color: var(--text-main); font-size: 0.95rem; margin-bottom: 0.35rem;">
                                🛡️ @tb.Name
                            </div>
                            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.5rem;">@tb.Description</p>
                            @if (tb.AssetsInside != null && tb.AssetsInside.Count > 0)
                            {
                                <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
                                    @foreach (var asset in tb.AssetsInside)
                                    {
                                        <span class="badge-clean-purple" style="font-size: 0.75rem;">@asset</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Threats Table -->
            <div class="saas-card-header">
                <h4 class="saas-card-title">Discovered STRIDE Threat Vectors</h4>
                <span class="badge-clean-gold">@(spec.ThreatModel?.Threats?.Count ?? 0) Vectors</span>
            </div>

            @if (spec.ThreatModel?.Threats != null && spec.ThreatModel.Threats.Count > 0)
            {
                <table class="saas-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>STRIDE Category</th>
                            <th>Target Asset</th>
                            <th>Severity</th>
                            <th>Mitigation Control</th>
                            <th>Residual Risk</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in spec.ThreatModel.Threats)
                        {
                            <tr>
                                <td><span class="badge-clean-gold">@t.Id</span></td>
                                <td><strong>@t.StrideCategory</strong></td>
                                <td><code style="color: var(--primary-purple);">@t.TargetAsset</code></td>
                                <td>
                                    <span class="@(t.Severity == "Critical" || t.Severity == "High" ? "badge-clean-red" : "badge-clean-gold")">
                                        @t.Severity
                                    </span>
                                </td>
                                <td style="color: var(--text-secondary); font-size: 0.88rem;">@t.MitigationControl</td>
                                <td><span class="badge-clean-green">@t.ResidualRisk</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: var(--accent-green); font-weight: 600;">✅ Zero active STRIDE threat vectors discovered for this service.</p>
            }
        </div>
    }

    <!-- TAB 8: Code Review -->
    @if (_activeTab == "codereview")
    {
        <div class="saas-card">
            <div class="saas-card-header">
                <div>
                    <h3 class="saas-card-title">Automated AI Code Review & Technical Audit</h3>
