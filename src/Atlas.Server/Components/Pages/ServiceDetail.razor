@page "/catalog/{ServiceName}"
@rendermode InteractiveServer
@inject SpecDocumentRepository SpecRepo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject VendorRfpExportService RfpService
@inject Neo4jGraphMapper GraphMapper
@inject Neo4jGraphService GraphService
@inject ArchitectureStitchingAgent StitchingAgent

<PageTitle>@(Resource?.Metadata?.Name ?? "Service Detail") - Atlas Enterprise Hub</PageTitle>

@if (Resource == null)
{
    <div class="saas-card" style="text-align: center; padding: 4rem;">
        <h2 style="color: var(--primary-purple);">404 — Microservice Not Found</h2>
        <p style="color: var(--text-secondary); margin-top: 0.5rem;">The requested service '@ServiceName' does not exist in the Atlas Catalog.</p>
        <a href="/catalog" class="sidebar-action-btn" style="display: inline-flex; margin-top: 1.5rem;">Return to Service Catalog</a>
    </div>
}
else
{
    var meta = Resource.Metadata;
    var spec = Resource.Spec;
    var commitSha = meta.Annotations != null && meta.Annotations.TryGetValue("atlas.io/git-commit", out var sha) && sha.Length >= 7 ? sha.Substring(0, 7) : "unknown";
    var branch = meta.Annotations != null && meta.Annotations.TryGetValue("atlas.io/git-branch", out var b) ? b : "master";
    var remote = meta.Annotations != null && meta.Annotations.TryGetValue("atlas.io/git-remote", out var r) ? r : "";

    <!-- Clean SaaS Header Banner -->
    <div class="saas-card" style="margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                    <a href="/catalog" style="color: var(--primary-purple); text-decoration: none; font-weight: 600;">📦 Service Catalog</a>
                    <span>/</span>
                    <span style="color: var(--text-main); font-weight: 700;">@meta.Name</span>
                </div>

                <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                    <h1 style="color: var(--text-main); font-size: 1.85rem; font-weight: 800;">
                        @meta.Name
                    </h1>
                    <span class="badge-clean-purple">@(spec.ComponentOverview?.Tier ?? "Backend")</span>
                    <span class="badge-clean-gold">⭐ @((spec.Quality?.SigStars ?? 4.0).ToString("0.0")) / 5.0</span>
                    @if (_historySummary?.PreviousSnapshot != null && _historySummary.LatestSnapshot != null)
                    {
                        var deltaStars = _historySummary.LatestSnapshot.DeltaSigStars;
                        if (deltaStars > 0)
                        {
                            <span class="badge-clean-green" title="Improved Quality vs Previous Scan">▲ +@deltaStars.ToString("0.0") ⭐</span>
                        }
                        else if (deltaStars < 0)
                        {
                            <span class="badge-clean-red" style="background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA;" title="Degraded Quality vs Previous Scan">▼ @deltaStars.ToString("0.0") ⭐</span>
                        }

                        var deltaThreats = _historySummary.LatestSnapshot.DeltaThreats;
                        if (deltaThreats < 0)
                        {
                            <span class="badge-clean-green" title="Threats Resolved vs Previous Scan">▼ @Math.Abs(deltaThreats) 🛡️</span>
                        }
                        else if (deltaThreats > 0)
                        {
                            <span class="badge-clean-red" style="background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA;" title="New Threats Introduced vs Previous Scan">▲ +@deltaThreats 🛡️</span>
                        }
                    }
                    <span class="badge-clean-green">Grade @(spec.CodeReview?.ReviewGrade ?? "A")</span>
                    <span class="badge-clean-purple">Risk: @(spec.RiskSummary?.OverallRiskLevel ?? "Low")</span>
                </div>

                <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.6rem; max-width: 900px; line-height: 1.5;">
                    @(spec.ComponentOverview?.Description ?? "No description provided.")
                </p>

                <div style="display: flex; gap: 1.5rem; margin-top: 0.85rem; font-size: 0.85rem; color: var(--text-secondary); flex-wrap: wrap;">
                    <span>📌 Git: <strong style="color: var(--text-main); font-family: var(--font-mono);">@commitSha</strong> (@branch)</span>
                    @if (!string.IsNullOrWhiteSpace(remote))
                    {
                        <span>🔗 <a href="@remote" target="_blank" style="color: var(--primary-purple); text-decoration: none; font-weight: 600;">@remote</a></span>
                    }
                    <span>👤 Owner: <strong style="color: var(--text-main);">@(spec.ComponentOverview?.Owner ?? "Platform Team")</strong></span>
                    <span>🚀 Lifecycle: <strong style="color: var(--text-main);">@(spec.ComponentOverview?.Lifecycle ?? "Active")</strong></span>
                </div>
            </div>

            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <a href="/blast-radius" class="saas-filter-pill" style="text-decoration: none; display: flex; align-items: center; gap: 0.35rem;">
                    <span>🚨 Blast Radius</span>
                </a>
                <a href="/api/v1/catalog/resources/@meta.Name/yaml" target="_blank" class="saas-filter-pill active" style="text-decoration: none;">
                    <span>📄 Raw YAML</span>
                </a>
                <button class="saas-filter-pill" style="background: #FEF2F2; color: #DC2626; border-color: #FECACA;" @onclick="() => _showDeleteConfirm = true">
                    <span>🗑️ Delete Service</span>
                </button>
            </div>
        </div>
    </div>

    @if (_showDeleteConfirm)
    {
        <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center;" @onclick="() => _showDeleteConfirm = false">
            <div style="background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 16px; padding: 2rem; max-width: 480px; width: 90%; box-shadow: var(--shadow-card);" @onclick:stopPropagation="true">
                <div style="text-align: center; margin-bottom: 1.5rem;">
                    <div style="font-size: 3rem;">⚠️</div>
                    <h3 style="color: #DC2626; margin: 0.5rem 0;">Permanently Delete Service</h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5;">
                        This will <strong>permanently remove</strong> <code style="background: #FEF2F2; color: #DC2626; padding: 0.1rem 0.4rem; border-radius: 4px;">@meta.Name</code>
                        from the Atlas catalog, including:
                    </p>
                </div>
                <ul style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.8; margin: 0 0 1.5rem 1.2rem;">
                    <li>All YAML specification files and version history</li>
                    <li>Neo4j graph nodes, endpoints, threats, and relationships</li>
                    <li>Synthesis cache snapshots</li>
                </ul>
                <p style="color: #DC2626; font-size: 0.8rem; font-weight: 600; text-align: center; margin-bottom: 1.5rem;">
                    ⛔ This action cannot be undone.
                </p>
                <div style="display: flex; gap: 0.75rem; justify-content: center;">
                    <button class="saas-filter-pill" style="padding: 0.6rem 1.5rem;" @onclick="() => _showDeleteConfirm = false">
                        Cancel
                    </button>
                    <button class="saas-filter-pill" style="background: #DC2626; color: white; border-color: #DC2626; padding: 0.6rem 1.5rem; font-weight: 700;"
                            @onclick="DeleteServiceAsync" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>🗑️ Yes, Delete Forever</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Complete Category Navigation Tab Bar (All YAML Categories Covered) -->
    <div style="display: flex; gap: 0.4rem; padding-bottom: 0.75rem; margin-bottom: 1.25rem; overflow-x: auto;">
        <button class="saas-filter-pill @(_activeTab == "architecture" ? "active" : "")" @onclick='() => SetTab("architecture")'>
            🏛️ Architecture & C4
        </button>
        <button class="saas-filter-pill @(_activeTab == "techstack" ? "active" : "")" @onclick='() => SetTab("techstack")'>
            🛠️ Tech Stack & Packages
        </button>
        <button class="saas-filter-pill @(_activeTab == "apis" ? "active" : "")" @onclick='() => SetTab("apis")'>
            🔌 APIs & Events (@(spec.ApiContracts?.Endpoints?.Count ?? 0))
        </button>
        <button class="saas-filter-pill @(_activeTab == "datastores" ? "active" : "")" @onclick='() => SetTab("datastores")'>
            🗄️ Data Stores & Config (@(spec.DataStores?.Databases?.Count ?? 0))
        </button>
        <button class="saas-filter-pill @(_activeTab == "observability" ? "active" : "")" @onclick='() => SetTab("observability")'>
            📡 Observability & Logs
        </button>
        <button class="saas-filter-pill @(_activeTab == "security" ? "active" : "")" @onclick='() => SetTab("security")'>
            🛡️ Security & OWASP (@(spec.Security?.Findings?.Count ?? 0))
        </button>
        <button class="saas-filter-pill @(_activeTab == "threatmodel" ? "active" : "")" @onclick='() => SetTab("threatmodel")'>
            🎯 STRIDE Threat Model (@(spec.ThreatModel?.Threats?.Count ?? 0))
        </button>
        <button class="saas-filter-pill @(_activeTab == "codereview" ? "active" : "")" @onclick='() => SetTab("codereview")'>
            📝 Code Review (@(spec.CodeReview?.ReviewGrade ?? "A"))
        </button>
        <button class="saas-filter-pill @(_activeTab == "quality" ? "active" : "")" @onclick='() => SetTab("quality")'>
            ⭐ SIG Quality (@(spec.Quality?.SigStars.ToString("0.0") ?? "4.0")★)
        </button>
        <button class="saas-filter-pill @(_activeTab == "risk" ? "active" : "")" @onclick='() => SetTab("risk")'>
            🚨 Risk & Blast Radius
        </button>
        <button class="saas-filter-pill @(_activeTab == "livingdocs" ? "active" : "")" @onclick='() => SetTab("livingdocs")'>
            📖 Living Specs & Invariants
        </button>
        <button class="saas-filter-pill @(_activeTab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
            📈 History & Trends (@(_historySummary?.Snapshots?.Count ?? 1))
        </button>
        <button class="saas-filter-pill @(_activeTab == "deployment" ? "active" : "")" @onclick='() => SetTab("deployment")'>
            🚀 Hosting & Topology (@(_deployments?.Count ?? 0))
        </button>
        <button class="saas-filter-pill @(_activeTab == "manifest" ? "active" : "")" @onclick='() => SetTab("manifest")'>
            📄 Raw Manifest
        </button>
    </div>

    <!-- TAB 1: Architecture & C4 Diagrams -->
    @if (_activeTab == "architecture")
    {
        <div class="saas-card" style="margin-bottom: 1.5rem;">
            <div class="saas-card-header" style="flex-wrap: wrap; gap: 0.75rem;">
                <div>
                    <h2 class="saas-card-title">Interactive C4 Architecture Suite</h2>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">
                        Architectural pattern: <strong>@(spec.Architecture?.Pattern ?? "Clean Architecture / Modular Monolith")</strong>
                    </div>
                </div>

                <div style="display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap;">
                    <button class="saas-filter-pill @(_activeDiagramType == "component" ? "active" : "")" @onclick='() => SwitchDiagram("component")'>
                        Level 2 Component
                    </button>
                    <button class="saas-filter-pill @(_activeDiagramType == "context" ? "active" : "")" @onclick='() => SwitchDiagram("context")'>
                        Level 1 Context
                    </button>
                    <button class="saas-filter-pill @(_activeDiagramType == "dataflow" ? "active" : "")" @onclick='() => SwitchDiagram("dataflow")'>
                        Level 3 Data Flow
                    </button>

                    <div style="width: 1px; height: 20px; background: var(--border-card); margin: 0 0.25rem;"></div>

                    <button class="saas-filter-pill" title="Copy Mermaid Definition" @onclick="CopyActiveMermaid">
                        📋 Copy Code
                    </button>
                    <button class="saas-filter-pill" title="Export Vector SVG" @onclick='() => ExportSvg("service-c4-viewport")'>
                        📥 SVG
                    </button>
                    <a href="/" class="saas-filter-pill" style="text-decoration: none;" title="Open Global Architecture Studio">
                        🌐 Global Studio
                    </a>
                </div>
            </div>

            <div id="service-c4-viewport" class="mermaid-viewport" style="background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 12px; min-height: 380px; display: flex; align-items: center; justify-content: center; padding: 1.5rem; overflow-x: auto;">
                <div style="color: var(--primary-purple); font-weight: 600;">Rendering C4 Architecture View...</div>
            </div>
        </div>

        @if (spec.Architecture?.Components != null && spec.Architecture.Components.Count > 0)
        {
            <div class="saas-card">
                <div class="saas-card-header">
                    <h3 class="saas-card-title">Internal Components & Domain Modules</h3>
                    <span class="badge-clean-purple">@spec.Architecture.Components.Count Modules</span>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem;">
                    @foreach (var comp in spec.Architecture.Components)
                    {
                        <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1.25rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <strong style="color: var(--text-main); font-size: 1rem;">@comp.Name</strong>
                                <span class="badge-clean-purple">@comp.Type</span>
                            </div>
                            <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 0.75rem;">
                                @comp.Description
                            </p>
                            @if (comp.Responsibilities != null && comp.Responsibilities.Count > 0)
                            {
                                <ul style="padding-left: 1.25rem; font-size: 0.82rem; color: var(--text-secondary);">
                                    @foreach (var resp in comp.Responsibilities)
                                    {
                                        <li style="margin-bottom: 0.2rem;">@resp</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- TAB 2: Tech Stack & Dependencies / SBOM -->
    @if (_activeTab == "techstack")
    {
        <div class="saas-card" style="margin-bottom: 1.5rem;">
            <div class="saas-card-header">
                <div>
                    <h3 class="saas-card-title">Technologies & Frameworks</h3>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">Primary Ecosystem: @(spec.TechStack?.PrimaryLanguage ?? "Unknown")</div>
                </div>
                @if (spec.Dependencies?.Sbom != null)
                {
                    <button class="saas-filter-pill" style="background: #F0EDFF; color: var(--primary-purple); font-weight: 700;" @onclick="DownloadServiceSbomAsync">
                        📥 Download CycloneDX 1.5 JSON
                    </button>
                }
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1rem;">
                    <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Languages</div>
                    <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.35rem;">
                        @foreach (var lang in spec.TechStack?.Languages ?? new List<TechItem>())
                        {
                            <span class="badge-clean-purple">@lang.Name @(lang.Version ?? "")</span>
                        }
                    </div>
                </div>

                <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1rem;">
                    <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Frameworks</div>
                    <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.35rem;">
                        @foreach (var fw in spec.TechStack?.Frameworks ?? new List<TechItem>())
                        {
                            <span class="badge-clean-green">@fw.Name @(fw.Version ?? "")</span>
                        }
                    </div>
                </div>

                <div style="background: var(--bg-subtle); border: 1px solid var(--border-card); border-radius: 12px; padding: 1rem;">
                    <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Runtimes & Build</div>
                    <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.35rem;">
                        @foreach (var rItem in spec.TechStack?.Runtimes ?? new List<TechItem>())
                        {
                            <span class="badge-clean-gold">@rItem.Name</span>
                        }
                    </div>
                </div>
            </div>

            <!-- CycloneDX 1.5 SBOM Component Inventory -->
            @if (spec.Dependencies?.Sbom?.Components != null && spec.Dependencies.Sbom.Components.Count > 0)
            {
                <div class="saas-card-header">
                    <div>
                        <h4 class="saas-card-title">CycloneDX 1.5 Component Inventory (SBOM)</h4>
                        <div style="font-size: 0.85rem; color: var(--text-secondary);">@spec.Dependencies.Sbom.Components.Count Tracked Direct & Transitive Libraries</div>
                    </div>
                    <span class="badge-clean-purple">CycloneDX 1.5 Standard</span>
                </div>

                <table class="saas-table" style="margin-bottom: 1.5rem;">
                    <thead>
                        <tr>
                            <th>Component Name</th>
                            <th>Version & PURL</th>
                            <th>SPDX License</th>
                            <th>Security (OSV.dev)</th>
                            <th>Supply Chain Lifecycle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in spec.Dependencies.Sbom.Components)
                        {
                            var licName = comp.Licenses.FirstOrDefault()?.License?.Name ?? comp.Licenses.FirstOrDefault()?.License?.Id ?? "MIT";
                            var osvUrl = comp.Properties.FirstOrDefault(p => p.Name == "atlas:osv:url")?.Value ?? $"https://osv.dev/list?q={Uri.EscapeDataString(comp.Name)}";
                            var isDep = comp.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:isDeprecated")?.Value == "true";
                            var depReason = comp.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:deprecatedReason")?.Value;
                            var latestVer = comp.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:latestVersion")?.Value;
                            var isOutdated = comp.Properties.FirstOrDefault(p => p.Name == "atlas:lifecycle:isOutdated")?.Value == "true";
                            var vulns = spec.Dependencies.Sbom.Vulnerabilities?.Where(v => v.Affects.Any(a => a.Ref == comp.Purl || a.Ref.Contains(comp.Name))).ToList() ?? new List<CycloneDxVulnerability>();

                            <tr>
                                <td>
                                    <strong style="color: var(--text-main);">@comp.Name</strong>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">@comp.Description</div>
                                </td>
                                <td>
                                    <code>@comp.Version</code>
                                    <div style="margin-top: 0.15rem;">
                                        <code style="background: #F0EDFF; color: var(--primary-purple); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.75rem;">@comp.Purl</code>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-clean-purple" style="font-size: 0.78rem;">📄 @licName</span>
                                </td>
                                <td>
                                    @if (vulns.Count > 0)
                                    {
                                        <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                                            @foreach (var v in vulns)
                                            {
                                                var sev = v.Ratings.FirstOrDefault()?.Severity ?? "High";
                                                <a href="@v.Source.Url" target="_blank" class="badge-clean-red" style="text-decoration: none; font-size: 0.75rem;">
                                                    🔴 @v.Id (@sev)
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="@osvUrl" target="_blank" class="badge-clean-green" style="text-decoration: none; font-size: 0.78rem;">
                                            🛡️ Verified Clean (0 CVEs)
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (isDep)
                                    {
                                        <span class="badge-clean-red" style="font-size: 0.75rem;">🚨 Deprecated</span>
                                        @if (!string.IsNullOrWhiteSpace(depReason))
                                        {
                                            <div style="font-size: 0.72rem; color: var(--text-muted);">@depReason</div>
                                        }
                                    }
                                    else if (isOutdated && !string.IsNullOrWhiteSpace(latestVer))
                                    {
                                        <span class="badge-clean-gold" style="font-size: 0.75rem;">Update: @latestVer</span>
                                    }
                                    else
                                    {
                                        <span style="color: #15803D; font-size: 0.78rem; font-weight: 500;">✓ Up to date</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <!-- Fallback: Key Packages -->
                <div class="saas-card-header">
                    <h4 class="saas-card-title">Key Package Dependencies</h4>
                    <span class="badge-clean-purple">@(spec.Dependencies?.KeyPackages?.Count ?? 0) Packages</span>
                </div>

                <table class="saas-table">
                    <thead>
                        <tr>
                            <th>Package Name</th>
                            <th>Version</th>
                            <th>Purpose / Architectural Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pkg in spec.Dependencies?.KeyPackages ?? new List<PackageDependency>())
                        {
                            <tr>
                                <td><strong>@pkg.Name</strong></td>
                                <td><code>@(pkg.Version ?? "Latest")</code></td>
                                <td style="color: var(--text-secondary);">@(pkg.Purpose ?? "Core runtime dependency")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <!-- OWASP Vulnerability Audit -->
            @if (spec.Dependencies?.VulnerabilityAudit?.Vulnerabilities != null && spec.Dependencies.VulnerabilityAudit.Vulnerabilities.Count > 0)
            {
                <div class="saas-card-header" style="margin-top: 1.5rem;">
                    <div>
                        <h4 class="saas-card-title">OWASP Vulnerability Audit (OSV.dev & GHSA)</h4>
                        <div style="font-size: 0.85rem; color: var(--text-secondary);">@spec.Dependencies.VulnerabilityAudit.TotalVulnerabilities Matched CVEs/GHSAs</div>
                    </div>
                    <span class="badge-clean-red">Action Required</span>
                </div>

                <table class="saas-table">
                    <thead>
                        <tr>
                            <th>Vulnerability ID</th>
                            <th>Component</th>
                            <th>Severity</th>
                            <th>Description</th>
                            <th>Fixed Version Remediation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vuln in spec.Dependencies.VulnerabilityAudit.Vulnerabilities)
                        {
                            var sev = vuln.Ratings.FirstOrDefault()?.Severity ?? "High";

                            <tr>
                                <td>
                                    <a href="@vuln.Source.Url" target="_blank" style="color: var(--primary-purple); font-weight: 700; text-decoration: none;">
                                        @vuln.Id
                                    </a>
                                </td>
                                <td><code>@(vuln.Affects.FirstOrDefault()?.Ref ?? "Package")</code></td>
                                <td>
                                    <span class="@(sev == "Critical" || sev == "High" ? "badge-clean-red" : "badge-clean-gold")">
                                        @sev
                                    </span>
                                </td>
                                <td style="color: var(--text-secondary); font-size: 0.85rem; max-width: 320px;">@vuln.Description</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(vuln.FixedVersion))
                                    {
                                        <span style="color: #15803D; font-weight: 700;">💡 Upgrade to >= @vuln.FixedVersion</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted);">Under vendor review</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
