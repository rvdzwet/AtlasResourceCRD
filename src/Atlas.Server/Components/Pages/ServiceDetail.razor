                                    </span>
                                </td>
                                <td><code style="font-weight: 700; color: var(--primary-purple);">@ep.Path</code></td>
                                <td style="color: var(--text-secondary);">@ep.Description</td>
                                <td>@(ep.AuthRequired ? "🔒 Required" : "🌐 Public")</td>
                                <td style="font-size: 0.82rem; color: var(--text-muted);">
                                    @(ep.RequestType ?? "void") ➔ @(ep.ResponseType ?? "void")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color: var(--text-secondary);">No HTTP endpoints declared for this service.</p>
            }
