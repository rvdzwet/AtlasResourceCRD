                            <th>Path</th>
                            <th>Description</th>
                            <th>Auth</th>
                            <th>Request / Response</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ep in spec.ApiContracts.Endpoints)
                        {
                            <tr>
