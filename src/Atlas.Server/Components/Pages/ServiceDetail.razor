                <div style="background: #F0FDF4; border-left: 4px solid var(--accent-green); padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.25rem;">
                    <h4 style="color: #166534; font-size: 0.95rem; margin-bottom: 0.5rem; font-weight: 700;">✨ Architectural Strengths</h4>
                    <ul style="padding-left: 1.25rem; color: var(--text-main); font-size: 0.88rem;">
                        @foreach (var str in spec.CodeReview.Strengths)
                        {
                            <li style="margin-bottom: 0.25rem;">@str</li>
                        }
