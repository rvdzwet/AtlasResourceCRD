    private static string CleanId(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "unknown";
        var sb = new System.Text.StringBuilder();
        foreach (var c in raw)
        {
            if (char.IsLetterOrDigit(c) || c == '_') sb.Append(c);
            else sb.Append('_');
        }
        return sb.ToString();
    }

