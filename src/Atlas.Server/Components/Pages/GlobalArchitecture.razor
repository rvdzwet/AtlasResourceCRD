    [JSInvokable]
    public async Task OnStudioNodeSelected(string nodeId)
    {
        PopulateSelectedNode(nodeId);
        _drawerTab = "overview";
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnStudioNodeDoubleClicked(string nodeId)
    {
        if (nodeId.StartsWith("dom_"))
        {
            var cleanDom = nodeId.Replace("dom_", "");
            var firstInDomain = SpecRepo.GetAll().FirstOrDefault(r => CleanId(r.Metadata.Name).Contains(cleanDom, StringComparison.OrdinalIgnoreCase) || cleanDom.Contains(CleanId(r.Metadata.Name), StringComparison.OrdinalIgnoreCase)) ?? SpecRepo.GetAll().FirstOrDefault();
            if (firstInDomain != null)
            {
                await PivotToFocal(firstInDomain.Metadata.Name);
            }
            return;
        }

        var res = SpecRepo.GetAll().FirstOrDefault(r => string.Equals(CleanId(r.Metadata.Name), nodeId, StringComparison.OrdinalIgnoreCase));
        if (res != null)
        {
            await PivotToFocal(res.Metadata.Name);
            return;
        }

        PopulateSelectedNode(nodeId);
        StateHasChanged();
    }

    private void PopulateSelectedNode(string nodeId)
    {
        var allResources = SpecRepo.GetAll();

        // 1. Check if Node is a Microservice
        var res = allResources.FirstOrDefault(r => string.Equals(CleanId(r.Metadata.Name), nodeId, StringComparison.OrdinalIgnoreCase));
        if (res != null)
        {
            _selectedResource = res;
            var spec = res.Spec;
            var overview = spec?.ComponentOverview;
            var tech = spec?.TechStack;
            var qual = spec?.Quality;
            var threatModel = spec?.ThreatModel;
            var risk = spec?.RiskSummary;

            var isMortgage = res.Metadata.Name.Contains("hypotheken", StringComparison.OrdinalIgnoreCase);
            var isIot = res.Metadata.Name.Contains("iot", StringComparison.OrdinalIgnoreCase);
            var domainName = isMortgage ? "Dutch Mortgage & Lending Core" : (isIot ? "Smart Home & IoT Automation" : "Platform Services");

            // Upstream Callers
            var inbound = new List<ConnectedServiceLink>();
            foreach (var other in allResources.Where(r => r.Metadata.Name != res.Metadata.Name))
            {
                var calls = other.Spec?.Dependencies?.InternalServices != null &&
                            other.Spec.Dependencies.InternalServices.Any(s => string.Equals(s.Name, res.Metadata.Name, StringComparison.OrdinalIgnoreCase));
                if (calls)
                {
                    inbound.Add(new ConnectedServiceLink
                    {
                        ServiceName = other.Metadata.Name,
                        Tier = other.Spec?.ComponentOverview?.Tier ?? "Backend",
                        Domain = other.Metadata.Name.Contains("hypotheken", StringComparison.OrdinalIgnoreCase) ? "Dutch Mortgage" : "IoT",
                        RoleOrProtocol = "gRPC / Internal",
                        Stars = other.Spec?.Quality?.SigStars ?? 4.0
                    });
                }
            }

            // Downstream Dependencies
            var outbound = new List<ConnectedServiceLink>();
            if (spec?.Dependencies?.InternalServices != null)
            {
                foreach (var dep in spec.Dependencies.InternalServices)
                {
                    var target = allResources.FirstOrDefault(r => string.Equals(r.Metadata.Name, dep.Name, StringComparison.OrdinalIgnoreCase));
                    outbound.Add(new ConnectedServiceLink
                    {
                        ServiceName = dep.Name,
                        Tier = target?.Spec?.ComponentOverview?.Tier ?? "Backend",
                        Domain = dep.Name.Contains("hypotheken", StringComparison.OrdinalIgnoreCase) ? "Dutch Mortgage" : "IoT",
                        RoleOrProtocol = dep.ProtocolOrHost ?? "gRPC",
                        Stars = target?.Spec?.Quality?.SigStars ?? 4.0
                    });
                }
            }

            _selectedNode = new SelectedNodeDto
            {
                Id = nodeId,
                Name = res.Metadata.Name,
                Type = "Service",
                Tier = overview?.Tier ?? "Backend",
                Domain = domainName,
                Description = overview?.Description ?? "",
                Purpose = overview?.Purpose ?? "",
                Owner = overview?.Owner ?? "Enterprise Architecture",
                Lifecycle = overview?.Lifecycle ?? "Active",
                PrimaryLanguage = tech?.PrimaryLanguage ?? "C# / .NET",
                Frameworks = tech?.Frameworks?.Select(f => f.Name).Where(n => !string.IsNullOrWhiteSpace(n)).ToList() ?? new List<string>(),
                ThreatCount = threatModel?.Threats?.Count ?? 0,
                QualityStars = qual?.SigStars ?? 4.0,
                ReviewGrade = spec?.CodeReview?.ReviewGrade ?? "A",
                RiskLevel = risk?.OverallRiskLevel ?? "Low",
                ProductionReadiness = risk?.ProductionReadiness ?? "Approved",
                InboundCallers = inbound,
                OutboundDependencies = outbound,
                Datastores = (spec?.DataStores?.Databases ?? new List<DataStoreSpec>()).Concat(spec?.DataStores?.Caches ?? new List<DataStoreSpec>()).ToList(),
                ExternalApis = spec?.Dependencies?.ExternalApis ?? new List<DependencyItem>(),
                EventContracts = spec?.ApiContracts?.Events ?? new List<EventContract>(),
                Threats = threatModel?.Threats ?? new List<ThreatVector>(),
                Endpoints = spec?.ApiContracts?.Endpoints ?? new List<ApiEndpoint>(),
                KeyPackages = spec?.Dependencies?.KeyPackages ?? new List<PackageDependency>()
            };
            return;
        }

        // 2. Check if Node is a Database
        if (nodeId.StartsWith("db_"))
        {
            var dbClean = nodeId.Replace("db_", "");
            var connected = new List<ConnectedServiceLink>();

            foreach (var r in allResources)
            {
                var usesDb = (r.Spec?.DataStores?.Databases != null && r.Spec.DataStores.Databases.Any(d => CleanId(d.Name).Contains(dbClean, StringComparison.OrdinalIgnoreCase) || dbClean.Contains(CleanId(d.Name), StringComparison.OrdinalIgnoreCase))) ||
                             (r.Spec?.DataStores?.Caches != null && r.Spec.DataStores.Caches.Any(c => CleanId(c.Name).Contains(dbClean, StringComparison.OrdinalIgnoreCase) || dbClean.Contains(CleanId(c.Name), StringComparison.OrdinalIgnoreCase)));
                if (usesDb)
                {
                    connected.Add(new ConnectedServiceLink
                    {
                        ServiceName = r.Metadata.Name,
                        Tier = r.Spec?.ComponentOverview?.Tier ?? "Backend",
                        Domain = r.Metadata.Name.Contains("hypotheken", StringComparison.OrdinalIgnoreCase) ? "Dutch Mortgage" : "IoT",
                        RoleOrProtocol = "PERSISTS / READ_WRITE"
                    });
                }
            }

            _selectedResource = null;
            _selectedNode = new SelectedNodeDto
            {
                Id = nodeId,
                Name = dbClean.Replace("_", " "),
                Type = "Database",
                Tier = "Datastore",
                Domain = "Data Layer",
                Subtitle = $"Relational Database / Distributed Cache holding entity state",
                ConnectedServices = connected
            };
            return;
        }

        // 3. Check if Node is an External API
        if (nodeId.StartsWith("ext_"))
        {
            var extClean = nodeId.Replace("ext_", "");
            var connected = new List<ConnectedServiceLink>();

            foreach (var r in allResources)
            {
                var usesExt = r.Spec?.Dependencies?.ExternalApis != null &&
                              r.Spec.Dependencies.ExternalApis.Any(e => CleanId(e.Name).Contains(extClean, StringComparison.OrdinalIgnoreCase) || extClean.Contains(CleanId(e.Name), StringComparison.OrdinalIgnoreCase));
                if (usesExt)
                {
                    connected.Add(new ConnectedServiceLink
                    {
                        ServiceName = r.Metadata.Name,
                        Tier = r.Spec?.ComponentOverview?.Tier ?? "Backend",
                        Domain = r.Metadata.Name.Contains("hypotheken", StringComparison.OrdinalIgnoreCase) ? "Dutch Mortgage" : "IoT",
                        RoleOrProtocol = "SaaS Consumer"
                    });
                }
            }

            _selectedResource = null;
            _selectedNode = new SelectedNodeDto
            {
                Id = nodeId,
                Name = extClean.Replace("_", " "),
                Type = "ExternalApi",
                Tier = "Cloud API",
                Domain = "Third-Party SaaS & Integrations",
                Subtitle = "External HTTP/REST or Cloud Service Provider",
                ConnectedServices = connected
            };
            return;
        }

        // 4. Check if Node is an Event Topic
        if (nodeId.StartsWith("event_"))
        {
            var eventClean = nodeId.Replace("event_", "");
            var connected = new List<ConnectedServiceLink>();

            foreach (var r in allResources)
            {
                var usesEvent = r.Spec?.ApiContracts?.Events != null &&
                                r.Spec.ApiContracts.Events.Any(e => CleanId(e.TopicOrQueue).Contains(eventClean, StringComparison.OrdinalIgnoreCase) || eventClean.Contains(CleanId(e.TopicOrQueue), StringComparison.OrdinalIgnoreCase));
                if (usesEvent)
                {
                    connected.Add(new ConnectedServiceLink
                    {
                        ServiceName = r.Metadata.Name,
                        Tier = r.Spec?.ComponentOverview?.Tier ?? "Backend",
                        Domain = r.Metadata.Name.Contains("hypotheken", StringComparison.OrdinalIgnoreCase) ? "Dutch Mortgage" : "IoT",
                        RoleOrProtocol = "PUBLISHER / SUBSCRIBER"
                    });
                }
            }

            _selectedResource = null;
            _selectedNode = new SelectedNodeDto
            {
                Id = nodeId,
                Name = eventClean.Replace("_", " "),
                Type = "EventTopic",
                Tier = "Event Stream",
                Domain = "Event Mesh & Messaging",
                Subtitle = "Kafka / RabbitMQ Asynchronous Event Topic",
                ConnectedServices = connected
            };
            return;
        }

        // 5. Check if Node is a Domain Hub
        if (nodeId.StartsWith("dom_"))
        {
            var domClean = nodeId.Replace("dom_", "").Replace("_", " ");
            var connected = allResources
                .Where(r => r.Metadata.Name.Contains("hypotheken", StringComparison.OrdinalIgnoreCase) && domClean.Contains("mortgage", StringComparison.OrdinalIgnoreCase) ||
                            r.Metadata.Name.Contains("iot", StringComparison.OrdinalIgnoreCase) && domClean.Contains("iot", StringComparison.OrdinalIgnoreCase))
                .Select(r => new ConnectedServiceLink
                {
                    ServiceName = r.Metadata.Name,
                    Tier = r.Spec?.ComponentOverview?.Tier ?? "Backend",
                    Domain = domClean,
                    RoleOrProtocol = "Member Microservice"
                }).ToList();

            _selectedResource = null;
            _selectedNode = new SelectedNodeDto
            {
                Id = nodeId,
                Name = domClean,
                Type = "DomainHub",
                Tier = "Domain Boundary",
                Domain = domClean,
                Subtitle = $"Bounded context grouping {connected.Count} microservices",
                ConnectedServices = connected
            };
            return;
        }

        // Fallback generic node
        _selectedResource = null;
        _selectedNode = new SelectedNodeDto
        {
            Id = nodeId,
            Name = nodeId,
            Type = "Component",
            Tier = "Infrastructure",
            Domain = "Enterprise Architecture",
            Subtitle = "Architecture node"
        };
    }

