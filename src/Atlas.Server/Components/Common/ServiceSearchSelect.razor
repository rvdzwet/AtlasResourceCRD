@namespace Atlas.Server.Components.Common
@inject Storage.SpecDocumentRepository SpecRepo

<div class="service-search-select-wrap" style="position: relative; width: 100%; max-width: @(MaxWidth ?? "380px");">
    <div style="display: flex; align-items: center; background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 8px; padding: 0.35rem 0.65rem; gap: 0.5rem; transition: border-color 0.15s ease;">
        <span style="font-size: 0.85rem; color: var(--text-muted);">🔍</span>
        
        <input type="text" class="service-search-input"
               style="flex: 1; border: none; outline: none; background: transparent; color: var(--text-main); font-size: 0.88rem; font-family: inherit;"
               placeholder="@(string.IsNullOrWhiteSpace(SelectedService) ? (Placeholder ?? "Search or select a service...") : SelectedService)"
               value="@_query"
               @oninput="OnInput"
               @onfocus="OnFocus"
               @onblur="OnBlur"
               @onkeydown="OnKeyDown" />

        @if (!string.IsNullOrWhiteSpace(SelectedService) && AllowClear)
        {
            <button type="button" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0.1rem 0.3rem; font-size: 0.8rem;"
                    @onclick="ClearSelection" title="Clear selection">
                ✕
            </button>
        }
    </div>

    @if (_isOpen && _results.Count > 0)
    {
        <div class="service-dropdown-menu"
             style="position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 8px; box-shadow: var(--shadow-card); max-height: 280px; overflow-y: auto; z-index: 1050; padding: 0.35rem 0;">
            
            <div style="padding: 0.3rem 0.75rem; font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; border-bottom: 1px solid var(--border-subtle);">
                Matching Services (@_results.Count)
            </div>

            @for (int i = 0; i < _results.Count; i++)
            {
                var index = i;
                var s = _results[i];
                var isHighlighted = index == _highlightedIndex;
                var isSelected = string.Equals(s.Name, SelectedService, StringComparison.OrdinalIgnoreCase);

                <div style="padding: 0.55rem 0.75rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; background: @(isHighlighted ? "var(--bg-subtle)" : (isSelected ? "var(--primary-purple-light)" : "transparent")); transition: background 0.1s ease;"
                     @onmousedown="() => SelectService(s.Name)"
                     @onmouseover="() => _highlightedIndex = index">
                    
                    <div style="display: flex; align-items: center; gap: 0.4rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <span style="font-size: 0.85rem;">📦</span>
                        <strong style="color: var(--text-main); font-size: 0.86rem; overflow: hidden; text-overflow: ellipsis;">@s.Name</strong>
                    </div>

                    <div style="display: flex; align-items: center; gap: 0.3rem; flex-shrink: 0;">
                        <span class="badge-clean-purple" style="font-size: 0.68rem; padding: 0.15rem 0.4rem;">@s.Tier</span>
                        <span style="font-size: 0.75rem; color: var(--accent-gold); font-weight: 700;">★ @s.SigStars.ToString("0.0")</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string SelectedService { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedServiceChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? MaxWidth { get; set; }

    [Parameter]
    public bool AllowClear { get; set; } = true;

    [Parameter]
    public int MaxResults { get; set; } = 15;

    private string _query = string.Empty;
    private bool _isOpen = false;
    private int _highlightedIndex = 0;
    private List<ServiceSummaryRecord> _results = new();

    protected override void OnInitialized()
    {
        RefreshResults();
    }

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _isOpen = true;
        _highlightedIndex = 0;
        RefreshResults();
    }

    private void OnFocus()
    {
        _isOpen = true;
        RefreshResults();
    }

    private async Task OnBlur()
    {
        // Give time for mousedown on dropdown item
        await Task.Delay(200);
        _isOpen = false;
        _query = string.Empty;
    }

    private void RefreshResults()
    {
        _results = SpecRepo.SearchSummaries(_query, MaxResults);
    }

    private async Task SelectService(string serviceName)
    {
        SelectedService = serviceName;
        _query = string.Empty;
        _isOpen = false;
        await SelectedServiceChanged.InvokeAsync(serviceName);
    }

    private async Task ClearSelection()
    {
        SelectedService = string.Empty;
        _query = string.Empty;
        await SelectedServiceChanged.InvokeAsync(string.Empty);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_isOpen || _results.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            _highlightedIndex = Math.Min(_results.Count - 1, _highlightedIndex + 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _highlightedIndex = Math.Max(0, _highlightedIndex - 1);
        }
        else if (e.Key == "Enter" && _highlightedIndex >= 0 && _highlightedIndex < _results.Count)
        {
            await SelectService(_results[_highlightedIndex].Name);
        }
        else if (e.Key == "Escape")
        {
            _isOpen = false;
        }
    }
}
