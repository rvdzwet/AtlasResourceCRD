<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Atlas - Enterprise Architecture & Software Catalog Hub</title>
    
    <!-- Stater Fonts: Inter & Roboto Slab & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Slab:wght@400;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Stater Theme Styles -->
    <link rel="stylesheet" href="css/stater-theme.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>
        (function() {
            var theme = localStorage.getItem('atlas-theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    
    <!-- Core 2D Architecture Engines -->
    <script src="https://cdn.jsdelivr.net/npm/cytoscape@3.28.1/dist/cytoscape.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dagre@0.8.5/dist/dagre.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/cytoscape-dagre@2.5.0/cytoscape-dagre.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    
    <!-- Interop Scripts -->
    <script src="js/stater-interop.js"></script>
    <script src="js/architecture-studio.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
