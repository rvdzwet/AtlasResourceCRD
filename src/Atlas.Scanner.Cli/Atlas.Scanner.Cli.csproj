<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Core\Atlas.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Atlas.Scanner.Cli</RootNamespace>
    <AssemblyName>atlas</AssemblyName>
    <Version>1.7.0</Version>
    <Authors>Romano van der Zwet</Authors>
    <Company>RoMars</Company>
    <Description>Atlas Scanner CLI - Map-Reduce Agentic Architecture and Software Catalog Scanner for the Atlas Platform.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atlas</ToolCommandName>
  </PropertyGroup>

</Project>
